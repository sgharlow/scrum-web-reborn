# Scrum Reborn - Environment Variables Template
# Copy this file to .env.local and fill in your actual values

# ==============================================================================
# REQUIRED - AWS Infrastructure Configuration
# ==============================================================================

# Cognito User Pool Configuration
VITE_COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
VITE_USER_POOL_ID=us-east-1_xxxxxxxxx
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# GraphQL API Configuration
VITE_GRAPHQL_ENDPOINT=https://xxxxx.appsync-api.us-east-1.amazonaws.com/graphql
VITE_APPSYNC_API_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# AWS Region
VITE_AWS_REGION=us-east-1
AWS_REGION=us-east-1

# ==============================================================================
# OPTIONAL - For Development and Testing
# ==============================================================================

# AWS Account ID (for reference)
AWS_ACCOUNT_ID=123456789012

# DynamoDB Table Name
DYNAMODB_TABLE_NAME=ScrumRealtimeTable

# Lambda Function Names
MUTATIONS_LAMBDA_NAME=scrum-reborn-mutations
TALLY_LAMBDA_NAME=scrum-reborn-tally-processor

# SQS Queue URL
TALLY_DLQ_URL=https://sqs.us-east-1.amazonaws.com/123456789012/scrum-reborn-tally-dlq

# Test User Credentials
TEST_USER_EMAIL=testuser@example.com
TEST_USER_USERNAME=testuser
TEST_USER_PASSWORD=TestPass123!

# ==============================================================================
# HOW TO GET THESE VALUES
# ==============================================================================

# After deploying infrastructure with AWS CDK:
#
# 1. Run: cd infra && cdk deploy
#
# 2. Copy the outputs:
#    - GraphQL Endpoint → VITE_GRAPHQL_ENDPOINT
#    - User Pool ID → VITE_COGNITO_USER_POOL_ID
#    - User Pool Client ID → VITE_COGNITO_CLIENT_ID
#    - Region → VITE_AWS_REGION
#
# 3. Create .env.local with these values
#
# 4. Restart dev server: npm run dev

# ==============================================================================
# SECURITY NOTES
# ==============================================================================

# ✅ DO:
# - Copy this file to .env.local
# - Fill in your actual values in .env.local
# - Keep .env.local private (it's in .gitignore)
# - Use different values for dev/staging/prod

# ❌ DON'T:
# - Commit .env.local to git
# - Share .env.local publicly
# - Hardcode values in source code
# - Use production credentials in development

# ==============================================================================
# TROUBLESHOOTING
# ==============================================================================

# Issue: "Auth UserPool not configured"
# Solution: Ensure VITE_COGNITO_USER_POOL_ID and VITE_COGNITO_CLIENT_ID are set

# Issue: "Network error" when signing in
# Solution: Verify VITE_GRAPHQL_ENDPOINT is correct and accessible

# Issue: Environment variables not loading
# Solution: Restart dev server after changing .env.local

# Issue: Can't sign in with test user
# Solution: Verify user exists in Cognito User Pool
